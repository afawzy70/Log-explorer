<?xml version="1.0" encoding="UTF-8"?>
<!--
  OS-1F real-Sandbox testbed - a tiny, reusable Spring Boot log generator,
  deployed ~10 times under different SERVICE_NAME/SERVICE_ROLE identities
  to produce realistic OpenShift workload/log diversity for real-cluster
  Log Explorer verification. TEST INFRASTRUCTURE ONLY - never a product
  dependency, never referenced by backend/ or frontend/.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.logexplorer.testbed</groupId>
  <artifactId>log-explorer-testbed-service</artifactId>
  <version>0.1.0</version>
  <name>log-explorer-testbed-service</name>
  <description>OS-1F real-Sandbox testbed log generator - test infrastructure, not a product artifact</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>testbed-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
