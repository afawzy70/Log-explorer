<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Legacy Remediation Slice 9 §A: the Windows standalone desktop shell.
    A small WinForms host (not WPF - fewer moving parts, no XAML build
    step) around Microsoft's own WebView2 control, embedding the Edge
    Chromium runtime that ships with Windows 10/11 rather than bundling a
    whole separate browser engine (the mission's own "do NOT use Electron
    unless strong technical evidence proves WebView2 is not viable" -
    WebView2 is viable and is Microsoft's own recommended lightweight
    embedding path, so that bar is met by using it).

    net8.0-windows: the lowest LTS .NET that ships current WebView2/WinForms
    support. win-x64 self-contained + single-file publish (see the
    packaging workflow) means end users need no separately-installed .NET
    runtime, matching the mission's "no Java/Node/npm requirement" bar
    extended to the launcher itself.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LogExplorerLauncher</AssemblyName>
    <RootNamespace>LogExplorer.Launcher</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- Per-monitor DPI awareness - a blurry-upscaled WebView2 surface on
         a high-DPI display would be a real, visible regression versus the
         browser tab experience this replaces. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Version metadata (Slice 9 §I "installer metadata") - overridden
         from CI via -p:Version=... using the real release tag; this is
         only the local/dev fallback. -->
    <Version>0.1.0</Version>
    <Product>Log Explorer</Product>
    <!-- v0.1.0 release/branding pass: Company is the Win32 FileVersionInfo
         field Windows Explorer surfaces as "Company" in a file's
         Properties > Details tab - the owner-required publisher/author
         identity, not a company name (no Ltd/LLC/Inc. suffix invented). -->
    <Company>Ahmed Fawzy elrifaye</Company>
    <Authors>Ahmed Fawzy elrifaye</Authors>
    <AssemblyTitle>Log Explorer</AssemblyTitle>
    <!-- Windows CI toolchain hardening (platform/windows-dotnet-nuget-
         restore-hardening) — a clean checkout must resolve the exact
         same dependency graph on every restore. `RestorePackagesWithLockFile`
         makes NuGet write/consume `packages.lock.json` (committed
         alongside this project) and, combined with the restore command's
         locked mode flag in CI (see .github/workflows/windows-desktop.yml),
         turns any drift between this file's dependencies and the
         committed lock file into an immediate, loud restore failure
         instead of a silent re-resolution against whatever NuGet.org
         happens to serve that day. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows CI toolchain hardening — no wildcard package versions in
         the release/desktop path (mission requirement). Floating
         versions ("1.0.*") make `dotnet restore` a live, non-reproducible
         network query against whatever NuGet.org happens to be serving
         as "latest 1.0.x" at build time; combined with a NuGet lock file
         (RestorePackagesWithLockFile above), a floating reference would
         also make the lock file itself meaningless (it would just keep
         re-locking to a different concrete version on every regeneration).
         1.0.4191.47 is the actual latest published, listed, stable (non-
         prerelease) release verified directly against the NuGet v3 API
         (api.nuget.org/v3-flatcontainer/microsoft.web.webview2/index.json,
         published 2026-08-28) at the time this hardening was authored —
         never guessed. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
