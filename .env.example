# Log Explorer — environment variable reference (CLAUDE.md §2 rule 6:
# variable names and harmless defaults only, never real secrets, never
# committed with real values). Phase K wires these into docker-compose.yml;
# they already work today via Spring Boot's standard env-var binding
# (LOGEXPLORER_DOCKER_MODE -> logexplorer.docker.mode, etc.) — see
# backend/src/main/resources/application.yml for the full defaults.

# --- Docker source (Phase C) ------------------------------------------------

# LOCAL (default) uses the local Docker socket / DOCKER_HOST env var exactly
# as the `docker` CLI itself would - nothing below is needed for LOCAL mode.
# REMOTE connects to an explicitly configured host/port instead. Remote
# Docker TCP exposure is NEVER a prerequisite for running Log Explorer -
# portable Compose (Phase K) is the primary deployment path.
LOGEXPLORER_DOCKER_MODE=LOCAL

# REMOTE mode only: the remote Docker host. No default - must be set.
LOGEXPLORER_DOCKER_HOST=

# REMOTE mode only: sensible default, always overridable.
LOGEXPLORER_DOCKER_PORT=2375

# REMOTE mode only: TLS is optional, never forced, never trust-all when on.
LOGEXPLORER_DOCKER_TLS=false

# REMOTE mode + TLS=true only: directory containing ca.pem/cert.pem/key.pem.
LOGEXPLORER_DOCKER_TLS_CERT_PATH=

# Optional: only discover/search containers belonging to this Compose
# project. Leave unset to discover every Compose-managed container the
# configured Docker connection can see.
LOGEXPLORER_DOCKER_COMPOSE_PROJECT_FILTER=

# Bounds - see backend/src/main/resources/application.yml for full defaults.
LOGEXPLORER_DOCKER_MAX_CONTAINERS=200
LOGEXPLORER_DOCKER_DEFAULT_TAIL_LINES=2000

# --- Search guardrails (Phase B) --------------------------------------------

LOGEXPLORER_SEARCH_DEFAULT_LIMIT=200
LOGEXPLORER_SEARCH_MAX_LIMIT=5000
