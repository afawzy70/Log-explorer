# Log Explorer — environment variable reference (CLAUDE.md §2 rule 6:
# variable names and harmless defaults only, never real secrets, never
# committed with real values). Phase K wires these into docker-compose.yml;
# they already work today via Spring Boot's standard env-var binding
# (LOGEXPLORER_DOCKER_MODE -> logexplorer.docker.mode, etc.) — see
# backend/src/main/resources/application.yml for the full defaults.
#
# Quick start (Phase K): cp .env.example .env && docker compose --profile demo up --build
# Full explanations: docs/RUN_GUIDE.md.

# --- Compose / ports (Phase K, updated to 3434 in Legacy Remediation Slice 9 §K) --

# Host port the app is published on, on 127.0.0.1 only (the container
# itself always listens on 3434 internally - see docker-compose.yml).
APP_PORT=3434

# Host port for the --profile loki-mock stub server.
MOCK_LOKI_PORT=3100

# Seed for the --profile demo log generator's deterministic fake corpus.
DEMO_LOG_GENERATOR_SEED=42

# "dev" enables the in-process Fixture source (fake, deterministic,
# dev/test-only data - zero external dependency, the default happy path).
# Set to something else (e.g. blank, or "prod") for a production-like run
# where only the real Docker/Loki sources are registered.
SPRING_PROFILES_ACTIVE=dev

# Comma-separated source IDs to disable even though a bean exists for them
# (valid IDs: local-docker, fixture, openshift-loki).
LOGEXPLORER_SOURCES_DISABLED=

# --- Docker source (Phase C) ------------------------------------------------

# LOCAL (default) uses the local Docker socket / DOCKER_HOST env var exactly
# as the `docker` CLI itself would - nothing below is needed for LOCAL mode.
# REMOTE connects to an explicitly configured host/port instead. Remote
# Docker TCP exposure is NEVER a prerequisite for running Log Explorer -
# portable Compose (Phase K) is the primary deployment path.
LOGEXPLORER_DOCKER_MODE=LOCAL

# REMOTE mode only: the remote Docker host. No default - must be set.
LOGEXPLORER_DOCKER_HOST=

# REMOTE mode only: sensible default, always overridable.
LOGEXPLORER_DOCKER_PORT=2375

# REMOTE mode only: TLS is optional, never forced, never trust-all when on.
LOGEXPLORER_DOCKER_TLS=false

# REMOTE mode + TLS=true only: directory containing ca.pem/cert.pem/key.pem.
LOGEXPLORER_DOCKER_TLS_CERT_PATH=

# Optional: only discover/search containers belonging to this Compose
# project. Leave unset to discover every Compose-managed container the
# configured Docker connection can see. This is a hard source boundary
# (Legacy Remediation Slice 3): containers from another Compose project
# never enter the candidate set for discovery/search/live-tail/context.
LOGEXPLORER_DOCKER_COMPOSE_PROJECT_FILTER=

# --- Remote Docker SSRF allowlist (Legacy Remediation Slice 3) --------------
#
# REMOTE mode host resolution is checked server-side against a default-deny
# policy for loopback/link-local/private-LAN/cloud-metadata addresses (see
# source.docker.security.RemoteHostGuard's own javadoc for the exact ranges).
# A genuinely-intended private corporate LAN Docker host must be explicitly
# allowlisted here - by CIDR, by exact hostname, or both. Both empty by
# default: out of the box, only an ordinary public address is reachable.
# Comma-separated (Spring's standard relaxed List<String> binding).
LOGEXPLORER_DOCKER_REMOTE_ALLOWLIST_CIDRS=
LOGEXPLORER_DOCKER_REMOTE_ALLOWLIST_HOSTNAMES=

# Real container discovery/logs/live-tail need /var/run/docker.sock
# actually mounted, which this repo's own Compose stack only ever does
# behind the explicit `docker-socket` profile + the
# docker-compose.docker-socket.yml override file (never mounted silently
# - CLAUDE.md §2 rule 10). See that file's own header and docs/RUN_GUIDE.md.

# Bounds - see backend/src/main/resources/application.yml for full defaults.
LOGEXPLORER_DOCKER_MAX_CONTAINERS=200
LOGEXPLORER_DOCKER_DEFAULT_TAIL_LINES=2000
LOGEXPLORER_DOCKER_REQUEST_TIMEOUT=10s
LOGEXPLORER_DOCKER_CONNECT_TIMEOUT=5s

# --- OpenShift Loki source (Phase D) ----------------------------------------

# No default - must be set to reach a real gateway. Never a real cluster URL
# here; this file holds names and harmless defaults only. Point this at the
# --profile loki-mock stub for an offline demo:
#   LOGEXPLORER_LOKI_BASE_URL=http://mock-loki:3100
LOGEXPLORER_LOKI_BASE_URL=

# Every segment of the LokiStack gateway path is configurable - nothing
# dangerously hardcoded. Defaults match a typical OpenShift LokiStack.
LOGEXPLORER_LOKI_GATEWAY_PREFIX=/api/logs/v1
LOGEXPLORER_LOKI_TENANT=application
LOGEXPLORER_LOKI_NAMESPACE_LABEL_KEY=kubernetes_namespace_name
LOGEXPLORER_LOKI_SERVICE_LABEL_KEY=app
LOGEXPLORER_LOKI_POD_LABEL_KEY=pod
LOGEXPLORER_LOKI_CONTAINER_LABEL_KEY=container

# Fixed per deployment - this backend is deployed with access to one
# namespace, this is not a per-request/per-user value.
LOGEXPLORER_LOKI_NAMESPACE=

# Bearer token is read fresh at request time from ONE of these - never
# committed, never logged (CLAUDE.md §2 rules 2 and 6). Env var takes
# precedence over the file when both are set. Leave both unset to query
# without a token (e.g. against an already-authenticated gateway/mock).
LOGEXPLORER_LOKI_TOKEN_ENV_VAR=
LOGEXPLORER_LOKI_TOKEN_FILE_PATH=

# TLS verification always stays on (CLAUDE.md §2 rule 7: no trust-all,
# ever). Optional: adds exactly one more trusted CA (e.g. an OpenShift
# cluster's internal CA) on top of the JVM's own default trust store - it
# never replaces or bypasses verification.
LOGEXPLORER_LOKI_CA_CERT_PATH=

# Config-gated capability flags - only ever true when genuinely supported;
# never faked (CLAUDE.md "capabilities reflect reality").
LOGEXPLORER_LOKI_RAW_LOG_QL_ENABLED=false
LOGEXPLORER_LOKI_LIVE_TAIL_SUPPORTED=false

# Bounds - see backend/src/main/resources/application.yml for full defaults.
LOGEXPLORER_LOKI_MAX_RESULTS_PER_QUERY=2000
LOGEXPLORER_LOKI_REQUEST_TIMEOUT=15s
LOGEXPLORER_LOKI_CONNECT_TIMEOUT=5s

# --- Search guardrails (Phase B) --------------------------------------------

LOGEXPLORER_SEARCH_DEFAULT_LIMIT=200
LOGEXPLORER_SEARCH_MAX_LIMIT=5000
LOGEXPLORER_SEARCH_MAX_TIME_RANGE=7d
LOGEXPLORER_SEARCH_REQUEST_TIMEOUT=30s
LOGEXPLORER_SEARCH_MAX_CONCURRENCY=8

# --- Live tail guardrails (Phase J) ------------------------------------------

LOGEXPLORER_LIVE_MAX_CONCURRENT_TAILS=4
LOGEXPLORER_LIVE_CONNECTION_TIMEOUT=30m
LOGEXPLORER_LIVE_HEARTBEAT_INTERVAL=15s
LOGEXPLORER_LIVE_SERVER_BUFFER_SIZE=500
