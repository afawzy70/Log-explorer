<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows CI toolchain hardening (platform/windows-dotnet-nuget-restore-
  hardening) — makes the launcher's NuGet source list explicit and
  diagnosable rather than inherited from whatever machine-wide NuGet.Config
  a given runner or developer machine happens to carry. `<clear />` removes
  every inherited source before adding back exactly the one this project
  actually needs: the official nuget.org v3 feed. No mirrors, no extra
  feeds - a smaller, explicit source list is also a smaller attack surface
  for a dependency-confusion-style package substitution.

  Placed at the repository root (alongside global.json) rather than under
  desktop/launcher specifically, since NuGet config discovery walks up the
  directory tree from the project being restored - this one file governs
  restore identically whether invoked from GitHub Actions or a future
  local Windows build script (mission §10 "local reproducibility
  alignment"), with no separate copy to keep in sync.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceCredentials />
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <!-- TLS-only, no insecure fallback; certificate verification is never
       disabled here or anywhere else in this project (CLAUDE.md §2 rule
       7's "TLS verification stays on" spirit extended to the toolchain
       itself, not just product network calls). -->
</configuration>
